// Cloudflare Worker: serves the React app (static assets) and the API under /api.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-platform",
  "main": "./src/api/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The live address (lab-platform.<subdomain>.workers.dev) until the product has its own domain.
  "workers_dev": true,
  // Daily housekeeping: expired sessions and old sign-in counters (src/api/auth/session.ts).
  "triggers": { "crons": ["30 2 * * *"] },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker; everything else is the app.
    "run_worker_first": ["/api/*"]
  },
  // Live Lab sessions (#65): one Durable Object per session holds its connections, with WebSocket
  // Hibernation so an idle class costs nothing. SQLite-backed, as the free plan requires.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveSession"] }],
  // AI features (#84) run on Workers AI's free daily allocation. Tests and end-to-end runs use a
  // fake model instead (AI_PROVIDER "fake"), since they cannot reach Cloudflare's.
  "ai": { "binding": "AI", "remote": true },
  "vars": { "AI_PROVIDER": "workers-ai" },
  // One shared database for all tenants. In production it is created with the EU jurisdiction,
  // so the data never leaves the EU; locally it lives in .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lab-platform",
      "database_id": "6ef34dd4-9fa9-4ab1-908a-cc62c739ae4b",
      "migrations_dir": "migrations"
    }
  ]
}
